@page "/partner/action-plans"
@using PartnerAppPortal.Portal.Services

<div class="portal-page partner-portal">
    <div class="eyebrow">Partner Portal</div>
    <h1 class="portal-title">Action Plans</h1>
    <p class="partner-section-note">
        Action plans are now part of the Partner Success Plan.
    </p>
    <div class="portal-panel">
        <a class="btn btn-primary portal-btn" href="@PartnerNav.SuccessPlan(CustomerIdFromQuery)">Open Partner Success Plan</a>
        <a class="btn btn-outline-secondary portal-btn" href="@PartnerNav.AppBoard(CustomerIdFromQuery)">Back to App Board</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "customerId")]
    public Guid? CustomerIdFromQuery { get; set; }
}
