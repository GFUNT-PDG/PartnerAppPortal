@page "/partner/marketplace-maturity"
@using Microsoft.AspNetCore.Components.Authorization
@using PartnerAppPortal.Core.Models.Crm
@using PartnerAppPortal.Portal.Components.SiteReports
@using PartnerAppPortal.Portal.Services

<div class="portal-page partner-portal progress-page">
    <div class="eyebrow">Partner Portal</div>
    <h1 class="portal-title">Marketplace Maturity Score</h1>

    @if (_loading)
    {
        <p class="portal-subtitle">Loading...</p>
    }
    else if (Customer is null)
    {
        <p class="portal-subtitle">Partner account could not be resolved.</p>
        <div class="portal-panel">
            <a class="btn btn-primary portal-btn" href="/">Return to login</a>
        </div>
    }
    else
    {
        <p class="portal-subtitle">Marketplace maturity for <strong>@Customer.Name</strong></p>
        <p class="partner-section-note">
            <a href="@PartnerNav.AppBoard(Customer.Id)">← Back to App Board</a>
        </p>

        <PartnerSiteReportFrame Customer="Customer"
                                ReportKey="@SiteReportFiles.MarketplaceMaturity"
                                Title="Marketplace Maturity Score"
                                NotPublishedMessage="The marketplace maturity score has not been published for this account yet." />
    }
</div>

@code {
    [Inject] SiteReportAccess Access { get; set; } = default!;
    [Inject] AuthenticationStateProvider AuthState { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "customerId")]
    public Guid? CustomerIdFromQuery { get; set; }

    private bool _loading = true;
    private Customer? Customer { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            Customer = await Access.ResolveAsync(auth.User, CustomerIdFromQuery);
        }
        finally
        {
            _loading = false;
        }
    }
}
