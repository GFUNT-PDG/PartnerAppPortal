@inherits PartnerAppPortal.Portal.Pages.Wizard.WizardStepBase
@using PartnerAppPortal.Core.Models.Assessments
@inject IAssessmentApiClient AssessmentApi

<h3>@Title</h3>

@if (!string.IsNullOrEmpty(Error))
{
    <p class="text-danger">@Error</p>
}

@if (CoSell == null)
{
    <p>Loading Co-Sell & Referral information...</p>
}
else
{
    <div class="mb-3">
        <label>Co-Sell Opportunities</label>
        <input type="number"
               class="form-control"
               @bind="CoSell.CoSellOpportunities" />
    </div>

    <div class="mb-3">
        <label>Referrals Submitted</label>
        <input type="number"
               class="form-control"
               @bind="CoSell.ReferralsSubmitted" />
    </div>

    <div class="mb-3">
        <label>Referrals Won</label>
        <input type="number"
               class="form-control"
               @bind="CoSell.ReferralsWon" />
    </div>

    <div class="mb-3">
        <label>Co-Sell Pipeline Value ($)</label>
        <input type="number"
               class="form-control"
               @bind="CoSell.PipelineValue" />
    </div>

    <button class="btn btn-secondary" @onclick="Back">Back</button>
    <button class="btn btn-primary" @onclick="Next">Next</button>
}

@code {
    public CoSellReferrals? CoSell { get; set; }
    private string? Error { get; set; }

    protected override string Section => "CoSell_Referrals";

    protected override async Task OnInitializedAsync()
    {
        Title = "Co-Sell & Referrals";

        try
        {
            CoSell = await AssessmentApi.GetCoSellReferralsAsync(State.AssessmentId)
                     ?? new CoSellReferrals();
        }
        catch (Exception ex)
        {
            Error = $"Could not load Co-Sell & Referral info: {ex.Message}";
            CoSell = new CoSellReferrals();
        }
    }

    private async Task Next()
    {
        try
        {
            await AssessmentApi.SaveCoSellReferralsAsync(State.AssessmentId, CoSell!);
            await OnNext.InvokeAsync();
        }
        catch (Exception ex)
        {
            Error = $"Save failed: {ex.Message}";
        }
    }

    private async Task Back()
    {
        await OnBack.InvokeAsync();
    }
}
