@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using PartnerAppPortal.Portal.Services
@inject IAssessmentApiClient AssessmentApi
@inject AuthenticationStateProvider AuthState

<div class="landing">
    <h1 class="landing-title">The PDG Partner Hub</h1>
    <p class="landing-subtitle">@(_busy ? "Signing you in..." : "Your Microsoft Partner Growth Platform")</p>

    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="landing-error">@Message</p>
        <a class="btn btn-primary landing-btn" href="MicrosoftIdentity/Account/SignOut">Sign out</a>
    }
</div>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;
    [Inject] PortalSession Session { get; set; } = default!;

    private string? Message { get; set; }
    private bool _busy = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var email = FindEmail(auth.User);
        if (string.IsNullOrWhiteSpace(email))
        {
            _busy = false;
            Message = "The Microsoft account did not include an email address.";
            return;
        }

        if (email.EndsWith("@partnerdevelopmentgroup.com", StringComparison.OrdinalIgnoreCase) ||
            email.EndsWith("@pdg.com", StringComparison.OrdinalIgnoreCase))
        {
            Session.SetEmployee(email);
            Nav.NavigateTo($"/dashboard/employee?email={Uri.EscapeDataString(email)}");
            return;
        }

        try
        {
            var customer = await AssessmentApi.FindCustomerByEmailAsync(email);
            if (customer is null || customer.Id == Guid.Empty)
            {
                _busy = false;
                Message = "No partner account found for " + email + ". " +
                          "The CRM sync must store that email on the account or a contact.";
                return;
            }

            Session.SetPartner(email, customer.Id);
            Nav.NavigateTo($"/dashboard/partner?customerId={customer.Id}&email={Uri.EscapeDataString(email)}");
        }
        catch (Exception ex)
        {
            _busy = false;
            Message = $"Could not verify partner login: {ex.Message}";
        }
    }

    private static string? FindEmail(ClaimsPrincipal user)
    {
        return user.FindFirst("preferred_username")?.Value
            ?? user.FindFirst("email")?.Value
            ?? user.FindFirst(ClaimTypes.Upn)?.Value
            ?? user.FindFirst(ClaimTypes.Email)?.Value;
    }
}
