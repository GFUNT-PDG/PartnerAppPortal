@page "/dashboard/partner"
@layout PartnerAppPortal.Portal.Shared.PartnerLayout
@using PartnerAppPortal.Core.Models.Crm
@using PartnerAppPortal.Portal.Services

<div class="portal-page partner-portal partner-app-board">
    <h1 class="portal-title">Partner Portal</h1>

    @if (!string.IsNullOrEmpty(LoadError))
    {
        <p class="text-danger">@LoadError</p>
        <div class="portal-panel">
            <a class="btn btn-primary portal-btn" href="/">Return to login</a>
        </div>
    }
    else if (_loading)
    {
        <p class="portal-subtitle">Loading your partner workspace...</p>
    }
    else if (Customer is null)
    {
        <p class="portal-subtitle">Partner account could not be resolved.</p>
        <div class="portal-panel">
            <a class="btn btn-primary portal-btn" href="/">Return to login</a>
        </div>
    }
    else
    {
        <div class="app-board-welcome">Welcome : <strong>@Customer.Name</strong></div>
        <p class="partner-section-note">Your apps for this account. Hover a tile for a preview.</p>

        @foreach (var group in Groups)
        {
            <section class="app-board-group">
                <h2 class="app-board-group-title">@group.Title</h2>
                <div class="app-board-grid @(group.Wide ? "app-board-grid-4" : null)">
                    @foreach (var tile in group.Tiles)
                    {
                        <a class="app-board-tile"
                           href="@tile.Href"
                           aria-label="@tile.Title">
                            <span class="app-board-tile-title">@tile.Title</span>
                            <span class="app-board-tile-cta">@tile.Cta</span>
                            <span class="hot-list-preview app-board-preview" aria-hidden="true">
                                <span class="hot-list-preview-chrome">
                                    <span></span><span></span><span></span>
                                </span>
                                <span class="hot-list-preview-body">
                                    <span class="hot-list-preview-title">@tile.Title</span>
                                    <span class="hot-list-preview-banner">@tile.PreviewBanner</span>
                                    <span class="hot-list-preview-line"></span>
                                    <span class="hot-list-preview-line short"></span>
                                    <span class="hot-list-preview-line"></span>
                                </span>
                            </span>
                        </a>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    [Inject] IAssessmentApiClient AssessmentApi { get; set; } = default!;
    [Inject] PortalSession Session { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "customerId")]
    public Guid? CustomerIdFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? EmailFromQuery { get; set; }

    private bool _loading = true;
    private string? LoadError { get; set; }
    private Customer? Customer { get; set; }
    private List<AppGroup> Groups { get; set; } = new();
    private string? Email { get; set; }

    private sealed class AppTile
    {
        public string Title { get; set; } = "";
        public string Href { get; set; } = "";
        public string Cta { get; set; } = "Open";
        public string PreviewBanner { get; set; } = "Open module";
    }

    private sealed class AppGroup
    {
        public string Title { get; set; } = "";
        public bool Wide { get; set; }
        public List<AppTile> Tiles { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        LoadError = null;

        try
        {
            Email = EmailFromQuery ?? Session.Email;
            if (!string.IsNullOrWhiteSpace(Email) && CustomerIdFromQuery is Guid cid)
                Session.SetPartner(Email, cid);

            if (CustomerIdFromQuery is not Guid id || id == Guid.Empty)
            {
                LoadError = "Missing partner customer. Please sign in again from the home page.";
                return;
            }

            var customers = await AssessmentApi.GetCustomersAsync() ?? new();
            Customer = customers.FirstOrDefault(c => c.Id == id);
            if (Customer is null)
            {
                LoadError = "Partner customer was not found.";
                return;
            }

            var portals = new List<AppTile>
            {
                new()
                {
                    Title = "Partner Assessment Portal",
                    Href = PartnerNav.Assessment(id, Email),
                    Cta = "View scores",
                    PreviewBanner = "Assessment results"
                }
            };
            if (Customer.SalesAcceleratorAccess)
            {
                portals.Add(new AppTile
                {
                    Title = "Sales Accelerator Portal",
                    Href = PartnerNav.SalesAccelerator(id, Email),
                    Cta = "Submit leads",
                    PreviewBanner = "CSV lead intake"
                });
            }

            Groups =
            [
                new AppGroup { Title = "Portals", Tiles = portals },
                new AppGroup
                {
                    Title = "Pages",
                    Tiles =
                    [
                        new AppTile
                        {
                            Title = "Partner Success Plan",
                            Href = PartnerNav.SuccessPlan(id, Email),
                            Cta = "View plan",
                            PreviewBanner = "Success plan"
                        },
                        new AppTile
                        {
                            Title = "Marketplace Maturity Score",
                            Href = PartnerNav.MarketplaceMaturity(id, Email),
                            Cta = "View score",
                            PreviewBanner = "Marketplace maturity"
                        }
                    ]
                },
                new AppGroup
                {
                    Title = "Documents",
                    Wide = true,
                    Tiles =
                    [
                        new AppTile
                        {
                            Title = "Document Library",
                            Href = PartnerNav.Documents(id, Email),
                            Cta = "View files",
                            PreviewBanner = "Teams Files / Shared"
                        },
                        new AppTile
                        {
                            Title = "WinWire Library",
                            Href = PartnerNav.WinWire(id, Email),
                            Cta = "View files",
                            PreviewBanner = "Sales Artifacts / Winwires"
                        },
                        new AppTile
                        {
                            Title = "SuperPower Slide",
                            Href = PartnerNav.SuperPowerSlide(id, Email),
                            Cta = "View slide",
                            PreviewBanner = "PDF / PowerPoint"
                        },
                        new AppTile
                        {
                            Title = "Sales One-Pager",
                            Href = PartnerNav.SalesOnePager(id, Email),
                            Cta = "View overview",
                            PreviewBanner = "Partner Pitch"
                        }
                    ]
                }
            ];
        }
        catch (Exception ex)
        {
            LoadError = $"Could not load App Board: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
